#!name = YouTube Premium反向筛选
#!desc = 手动检测指定策略组的节点，仅选中明确提示不支持 YouTube Premium 的节点；异常不切换
#!author = MiaoWaa
#!homepage = https://github.com/MiaoWaa/loon
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
group = input,"YouTube",type=string,tag=待筛选策略组,desc=默认 YouTube

[Script]
# YouTube Premium 反向筛选（手动执行）
generic then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/youtube/premium-reverse-filter.js", {${group}}) with tag="YouTube反向筛选", img_url="play.circle.system", timeout=300
