#!name = YouTube反向筛选
#!desc = 手动执行脚本，选中不支持 YouTube Premium 的节点，达到去广告效果。
#!author = MiaoWaa | 检测参考：XIAO_KOP
#!homepage = https://github.com/MiaoWaa/loon
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(983)
#!type = normal

# YouTube Premium 地区限制检测参考 XIAO_KOP
# 原始脚本：https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/streaming-ui-check.js
# 反向筛选与策略组自动切换：MiaoWaa

[Argument]
group = input,"YouTube",type=string,tag=待筛选策略组,desc=默认 YouTube

[Script]
# YouTube Premium 反向筛选（手动执行）
generic then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/youtube/premium-reverse-filter-v2.js", {${group}}) with tag="YouTube反向筛选", img_url="play.circle.system", timeout=300
