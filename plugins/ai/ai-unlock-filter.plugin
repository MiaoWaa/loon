#!name = AI解锁筛选
#!desc = 手动执行脚本，筛选 ChatGPT 或 Gemini 各自策略组的可用节点并选中。
#!author = MiaoWaa | ChatGPT检测参考：XIAO_KOP
#!reference = https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/streaming-ui-check.js
#!homepage = https://github.com/MiaoWaa/loon
#!icon = https://raw.githubusercontent.com/MiaoWaa/loon/main/icons/ai-unlock.png
#!system = iOS,iPadOS,tvOS,macOS
#!type = normal

# ChatGPT 检测参考 XIAO_KOP 的流媒体解锁检测思路；Gemini 检测独立实现
# 插件整合与节点自动选择：MiaoWaa

[Argument]
chatgpt_group = input,"ChatGPT",type=string,tag=ChatGPT策略组,desc=默认 ChatGPT
gemini_group = input,"Gemini",type=string,tag=Gemini策略组,desc=默认 Gemini

[Script]
# ChatGPT 解锁筛选（手动执行）
generic then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/chatgpt/unlock-filter.js", {${chatgpt_group}}) with tag="ChatGPT解锁筛选", timeout=300

# Gemini 解锁筛选（手动执行）
generic then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/gemini/unlock-filter.js", {${gemini_group}}) with tag="Gemini解锁筛选", timeout=300
