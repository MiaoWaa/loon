#!name = Emby线路切换
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Emby.png
#!desc = 北京时间 19:00 切专线，02:00 恢复普通线路；可自定义三个策略组名称
#!author = MiaoWaa
#!homepage = https://github.com/MiaoWaa/loon
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(983)
#!tag = Emby,策略切换
#!type = normal

[Argument]
group = input,"Emby",type=string,tag=主策略组,desc=例如 Emby
normal = input,"EM-D",type=string,tag=普通线路策略组,desc=例如 EM-D
premium = input,"EM-P",type=string,tag=专线策略组,desc=例如 EM-P
notify = switch,true,tag=切换通知,desc=定时切换成功或失败时通知，已是目标线路不通知

[Script]
# Emby 手动切换
generic then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/emby/plugin-manual.js?v=20261115-align7", {${group}, ${normal}, ${premium}}) with tag="Emby手动切换", timeout=30

# Emby 晚高峰切换专线
cron "0 19 * * *" then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/emby/plugin-cron.js?v=20261115-align7", {${group}, ${normal}, ${premium}, ${notify}}) with tag="Emby切换专线", timeout=30

# Emby 凌晨恢复普通线路
cron "0 2 * * *" then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/emby/plugin-cron.js?v=20261115-align7", {${group}, ${normal}, ${premium}, ${notify}}) with tag="Emby恢复普通", timeout=30
