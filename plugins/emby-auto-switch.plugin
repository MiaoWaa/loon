#!name = Emby线路切换
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Emby.png
#!desc = 北京时间 19:00 切专线，02:00 恢复普通线路；可自定义三个策略组名称
#!author = MiaoWaa
#!homepage = https://github.com/MiaoWaa/loon
#!system = iOS,iPadOS,tvOS,macOS
#!loon_version = 3.5.1(983)
#!tag = Emby,策略切换
#!type = normal

[Argument]
group = input,"Emby",type=string,tag=主策略组,desc=例如 Emby
normal = input,"EM-D",type=string,tag=普通线路策略组,desc=例如 EM-D
premium = input,"EM-P",type=string,tag=专线策略组,desc=例如 EM-P
switch_premium = switch,true,tag=自动切换专线,desc=每天19:00
switch_normal = switch,true,tag=自动恢复普通,desc=每天02:00

[Script]
# Emby 手动切换
generic then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/emby/plugin-manual.js", {${group}, ${normal}, ${premium}}) with tag="Emby手动切换", timeout=30

# Emby 晚高峰切换专线
cron "0 19 * * *" then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/emby/plugin-cron.js", {${group}, ${normal}, ${premium}}) with enable=${switch_premium}, tag="Emby切换专线", timeout=30

# Emby 凌晨恢复普通线路
cron "0 2 * * *" then script("https://raw.githubusercontent.com/MiaoWaa/loon/main/scripts/emby/plugin-cron.js", {${group}, ${normal}, ${premium}}) with enable=${switch_normal}, tag="Emby恢复普通", timeout=30
